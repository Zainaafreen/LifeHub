PORT=5000
NODE_ENV=development   # Set to "production" on live servers

JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

DATABASE_URL=postgres://lifehub:lifehub@localhost:5432/lifehub
DB_SSL_CA=                   # Path to CA cert when DB requires TLS (optional in dev)

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://www.example.com
ALLOWED_ORIGIN=http://localhost:5000
APP_BASE_URL=http://localhost:5000

RESEND_API_KEY=xxxxxxxxxx
RESEND_FROM=LifeHub <onboarding@resend.dev>

BACKEND_URL=backend URL 
FRONTEND_URL=frontend URL 

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── DB Backups (manual / cron) ────────────────────────────────────────────────
# Daily backup example (add to crontab -e):
#   0 2 * * * docker exec lifehub-db-1 pg_dump -U lifehub lifehub | gzip > /backups/lifehub_$(date +\%F).sql.gz
#
# Restore:
#   gunzip < /backups/lifehub_2025-01-01.sql.gz | docker exec -i lifehub-db-1 psql -U lifehub lifehub
#
# Prune backups older than 30 days:
#   find /backups -name "lifehub_*.sql.gz" -mtime +30 -delete

