PORT=5000
NODE_ENV=development   # Set to "production" on live servers

JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

DATABASE_URL=postgres://lifehub:lifehub@localhost:5432/lifehub
DB_SSL_CA=                   # Path to CA cert when DB requires TLS (optional in dev)

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://www.example.com
ALLOWED_ORIGIN=http://localhost:5000
APP_BASE_URL=http://localhost:5000

BREVO_API_KEY=api-key-goes-here
BREVO_FROM=owner@gmail.com

VAPID_PUBLIC_KEY=YOUR_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_PRIVATE_KEY
VAPID_EMAIL=mailto:

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info


